// prisma/schema.prisma

datasource db {
  provider = "mysql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// ENUM

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum SupplyStatus {
  PENDING
  DONE
  CANCELLED
}

enum CommonStatus {
  ACTIVE
  INACTIVE
}

// ================= MODELS =================

model User {
  user_id    Int        @id @default(autoincrement())
  fullname   String
  email      String     @unique
  password   String
  role       Role       @default(USER)
  status     UserStatus @default(ACTIVE)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  addresses     Address[]
  orders        Order[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user_id Int
  user    User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model Address {
  address_id       Int      @id @default(autoincrement())
  name             String
  phone            String   @db.VarChar(15)
  shipping_address String   @db.Text
  isDefault        Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user_id Int
  user    User @relation(fields: [user_id], references: [user_id])
}

model Category {
  category_id Int          @id @default(autoincrement())
  name        String
  description String?      @db.Text
  status      CommonStatus @default(ACTIVE)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  books Book[]
}

model Author {
  author_id  Int          @id @default(autoincrement())
  name       String
  status     CommonStatus @default(ACTIVE)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  bookAuthors BookAuthor[]
}

model Book {
  book_id     Int          @id @default(autoincrement())
  title       String
  price       Decimal      @db.Decimal(10, 2)
  stock       Int          @default(0)
  image_url   String?      @db.VarChar(255)
  status      CommonStatus @default(ACTIVE)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  category_id Int
  category    Category @relation(fields: [category_id], references: [category_id])

  bookAuthors  BookAuthor[]
  orderItems   OrderItem[]
  supplyDetails SupplyDetail[]
}

model BookAuthor {
  bookauthor_id Int      @id @default(autoincrement())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  book_id   Int
  book      Book   @relation(fields: [book_id], references: [book_id])
  author_id Int
  author    Author @relation(fields: [author_id], references: [author_id])

  @@unique([book_id, author_id])
}

//////////////////////
//  NEW: SUPPLIER  //
//////////////////////

model Supplier {
  supplier_id Int          @id @default(autoincrement())
  name        String
  email       String?      @unique
  phone String? @unique @db.VarChar(15)
  address     String?      @db.Text
  status      CommonStatus @default(ACTIVE)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  supplies Supply[]
}

model Supply {
  supply_id    Int          @id @default(autoincrement())
  imported_at  DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  total_amount Decimal      @db.Decimal(15, 2)
  status       SupplyStatus @default(PENDING)

  // FK Supplier
  supplier_id Int
  supplier    Supplier @relation(fields: [supplier_id], references: [supplier_id])

  details SupplyDetail[]
}

model SupplyDetail {
  supply_detail_id Int     @id @default(autoincrement())
  quantity         Int
  imported_price   Decimal @db.Decimal(10, 2)

  supply_id Int
  supply    Supply @relation(fields: [supply_id], references: [supply_id])

  book_id Int
  book    Book @relation(fields: [book_id], references: [book_id])
}

model Discount {
  discount_id         Int          @id @default(autoincrement())
  code                String       @unique
  description         String?      @db.Text
  discount_type       DiscountType
  discount_value      Decimal      @db.Decimal(10, 2)
  max_discount_amount Decimal?     @db.Decimal(10, 2)
  min_order_value     Decimal?     @db.Decimal(10, 2)
  start_at            DateTime
  expires_at          DateTime
  used_count          Int
  usage_limit         Int?
  status              CommonStatus @default(ACTIVE)
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  orders Order[]
}

model Order {
  order_id         Int         @id @default(autoincrement())
  totalPrice       Decimal     @db.Decimal(15, 2)
  receiver_name    String
  receiver_phone   String      @db.VarChar(15)
  shipping_address String      @db.Text
  discount_amount  Decimal     @default(0) @db.Decimal(10, 2)
  status           OrderStatus @default(PENDING)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  user_id Int
  user    User @relation(fields: [user_id], references: [user_id])

  discount_id Int?
  discount    Discount? @relation(fields: [discount_id], references: [discount_id])

  items OrderItem[]
}

model OrderItem {
  orderitem_id Int      @id @default(autoincrement())
  quantity     Int
  price        Decimal  @db.Decimal(10, 2)
  status       String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  order_id Int
  order    Order @relation(fields: [order_id], references: [order_id])

  book_id Int
  book    Book @relation(fields: [book_id], references: [book_id])
}
